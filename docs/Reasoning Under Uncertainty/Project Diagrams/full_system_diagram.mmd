graph TD
    subgraph Agent_Level_Nodes ["Agent Level Nodes"]
        LiDAR["LiDAR"]:::outOfScope
        NoiseInjector["NoiseInjector"]:::jhuPrimary
        Octo["octomap_server"]:::outOfScope
        AL["AgentLocalizer"]:::jhuPrimary
        LMP["Local Motion Planner"]:::outOfScope
        PC["Position Controller"]:::outOfScope
        DDM["DiffDrive Model"]:::outOfScope
        Actuators["Actuators"]:::outOfScope
    end
    
    Octo -->|"Map"| LMP
    Octo ==>|"Map"| AL
    
    AL ==>|"X_t"| LMP
    LMP -->|"Target"| PC
    
    LiDAR ==>|"LaserScan"| AL
    DDM ==>|"Odometry"| NoiseInjector
    NoiseInjector ==>|"Noisy Odometry"| AL
    AL ==>|"X_t"| PC
    PC -->|"(v, ω)"| DDM
    DDM -->|"Joint\nVelocities"| Actuators

    %% JHU Theme Node Styling
    classDef jhuPrimary fill:#002D72,stroke:#001A40,stroke-width:2px,color:white;
    classDef jhuGold fill:#CFB53B,stroke:#9E8721,stroke-width:2px,color:black;
    classDef outOfScope fill:#E5E2E0,stroke:#9A9A9A,stroke-width:2px,color:black;

    %% Apply Classes
    class AL jhuGold;
    class Sensors jhuPrimary;
    class Actuators,Octo,LMP,PC,DDM outOfScope;

    %% Subgraph Styling
    style Agent_Level_Nodes fill:#EBF3FA,stroke:#002D72,stroke-width:2px,color:black;