<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="maze_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename='gz-sim-contact-system' name='gz::sim::systems::Contact' />
    <plugin filename='gz-sim-sensors-system' name='gz::sim::systems::Sensors' />
    <plugin filename="BasicSystem" name="devol_gazebo::BasicSystem" />
    <plugin filename="FullSystem" name="devol_gazebo::FullSystem" />

    <gravity>0 0 -9.8</gravity>

    <model name="aws_robomaker_warehouse_WallB_01_001">
      <include>
        <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_WallB_01</uri>
      </include>
      <static>true</static>
    </model>

    <model name="aws_robomaker_warehouse_GroundB_01_001">
      <include>
        <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_GroundB_01</uri>
      </include>
      <pose>0.0 0.0 -0.090092 0 0 0</pose>
      <static>true</static>
    </model>

    <light name="Warehouse_CeilingLight_003" type="point">
      <pose>0 0 8.5 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>80</range>
        <constant>0.3</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
      <direction>0.1 0.1 -1</direction>
    </light>

    <model name="table_single_link">
      <static>true</static>
      <pose>2.3 0 0 0 0 0</pose>

      <link name="table">
        <visual name="tabletop">
          <geometry>
            <box>
              <size>2.0 2.5 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.5 0.3 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
          <pose>0 0 1.0 0 0 0</pose>
        </visual>

        <collision name="tabletop_collision">
          <geometry>
            <box>
              <size>2.0 2.5 0.1</size>
            </box>
          </geometry>
          <pose>0 0 1.0 0 0 0</pose>
        </collision>

        <visual name="leg1_visual">
          <geometry>
            <box>
              <size>0.1 0.1 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.1 1</ambient>
            <diffuse>0.4 0.2 0.1 1</diffuse>
          </material>
          <pose> 0.95  1.2 0.5 0 0 0</pose>
        </visual>

        <collision name="leg1_collision">
          <geometry>
            <box>
              <size>0.1 0.1 1.0</size>
            </box>
          </geometry>
          <pose> 0.95  1.2 0.5 0 0 0</pose>
        </collision>

        <visual name="leg2_visual">
          <geometry>
            <box>
              <size>0.1 0.1 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.1 1</ambient>
            <diffuse>0.4 0.2 0.1 1</diffuse>
          </material>
          <pose>-0.95  1.2 0.5 0 0 0</pose>
        </visual>

        <collision name="leg2_collision">
          <geometry>
            <box>
              <size>0.1 0.1 1.0</size>
            </box>
          </geometry>
          <pose>-0.95  1.2 0.5 0 0 0</pose>
        </collision>

        <visual name="leg3_visual">
          <geometry>
            <box>
              <size>0.1 0.1 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.1 1</ambient>
            <diffuse>0.4 0.2 0.1 1</diffuse>
          </material>
          <pose> 0.95 -1.2 0.5 0 0 0</pose>
        </visual>

        <collision name="leg3_collision">
          <geometry>
            <box>
              <size>0.1 0.1 1.0</size>
            </box>
          </geometry>
          <pose> 0.95 -1.2 0.5 0 0 0</pose>
        </collision>

        <visual name="leg4_visual">
          <geometry>
            <box>
              <size>0.1 0.1 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.1 1</ambient>
            <diffuse>0.4 0.2 0.1 1</diffuse>
          </material>
          <pose>-0.95 -1.2 0.5 0 0 0</pose>
        </visual>

        <collision name="leg4_collision">
          <geometry>
            <box>
              <size>0.1 0.1 1.0</size>
            </box>
          </geometry>
          <pose>-0.95 -1.2 0.5 0 0 0</pose>
        </collision>

      </link>
    </model>

    <model name="diagonal_qr">
      <static>true</static>
      <include>
        <uri>/workspace/devol/src/common/tlt_part_description/models/diagonal/model.sdf</uri>
      </include>
      <pose>1.4 0 1.1 1.570796 0 0</pose>

      <plugin filename="libgz-sim-pose-publisher-system.so" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>true</publish_link_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
    </model>

  </world>
</sdf>